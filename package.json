{
  "name": "merge-schedule-action",
  "private": true,
  "version": "0.0.2",
  "description": "GitHub Action to merge pull requests on a scheduled day",
  "repository": "github:geolonia/merge-schedule-action",
  "keywords": [
    "github-action"
  ],
  "author": "Gregor Martynus (https://twitter.com/gr2m), Geolonia (https://geolonia.com)",
  "license": "ISC",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "esbuild lib/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js --metafile=dist/meta.json && node scripts/licenses.mjs",
    "lint": "eslint .",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "mockdate": "^3.0.5",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      "@semantic-release/npm",
      "semantic-release-plugin-github-breaking-version-tag",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "dist/*"
          ],
          "message": "build(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "dayjs": "^1.11.23"
  },
  "prettier": {},
  "engines": {
    "node": ">=22.12.0"
  }
}
